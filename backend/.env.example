# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 올라가지 않는다.
# 값은 Supabase 대시보드 → Project Settings → API Keys / Data API 에서 확인

APP_MODE=supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 아래 키는 모든 데이터에 접근할 수 있다. 서버(.env, Render 환경 변수)에만 둔다
SUPABASE_SECRET_KEY=sb_secret_...

# 대시보드 주소를 쉼표로 구분 (예: https://esp32-iot.vercel.app,http://localhost:5500). * 는 모두 허용
CORS_ORIGINS=*
DEVICE_INTERVAL_MS=3000
ONLINE_TIMEOUT_S=15
